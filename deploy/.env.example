# ─────────────────────────────────────────────────────────────
# Gateway (ContextForge) — required
# ─────────────────────────────────────────────────────────────
# Rotate before prod. Must be >= 32 bytes.
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_AUDIENCE=mcpgateway-api
JWT_ISSUER=mcpgateway

# Admin used by the bootstrap job and Admin UI login.
# Seed happens once on first migration — rotating this later needs a DB reset
# (`make clean`) or a manual password reset via the Admin UI.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=changeme

# Postgres password used by the bundled DB.
POSTGRES_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────
# dashboard-context admin (редактор каталога на http://localhost:${ADMIN_PORT}/)
# Basic-auth защищает HTML-редактор. Ручки /api/*, которые MCP-сервер
# дёргает по внутренней Docker-сети, специально без авторизации — поэтому
# этот сервис нельзя пробрасывать наружу через nginx.
# ─────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
ADMIN_PORT=8010
# Хранилище каталога dashboard-context (ТС «каталог в БД»). Пусто = YAML-файл.
# Для Postgres — URL (БД и схема создаются автоматически, YAML переливается разово).
# Пароль должен совпадать с POSTGRES_PASSWORD. Хост `postgres` — сервис из стека.
DASHBOARD_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/dashboard_context

# presentation-context admin (style guide editor on http://localhost:${PRESENTATION_ADMIN_PORT}/)
PRESENTATION_ADMIN_USER=admin
PRESENTATION_ADMIN_PASSWORD=changeme
PRESENTATION_ADMIN_PORT=8011

# ─────────────────────────────────────────────────────────────
# admin-console — единый вход с ролевым разделением (ТС 5.6, Уровень 2)
# Один URL http://localhost:${CONSOLE_PORT}/ — логин по роли:
#   analyst      → бизнес-контекст + презентации (НЕ видит PAT-привязки)
#   access-admin → PAT-привязки (tableau-identity)
#   admin        → всё
# Бэкенд-админки сняты с хост-портов и доступны только через консоль.
# ─────────────────────────────────────────────────────────────
CONSOLE_PORT=8030
CONSOLE_ANALYST_PASSWORD=changeme
CONSOLE_ACCESS_ADMIN_PASSWORD=changeme
CONSOLE_ADMIN_PASSWORD=changeme

# ─────────────────────────────────────────────────────────────
# tableau-identity — per-user PAT-брокер + админка 1:1-маппинга (ТС 5.4.2/5.6.2)
#
# TABLEAU_IDENTITY_ENC_KEY — ключ шифрования PAT-секретов в mappings.yml
#   (Fernet, urlsafe base64, 32 байта). Сгенерировать: `make identity-key`.
#   ОБЯЗАТЕЛЕН. Потеря ключа = нужно перевнести PAT-ы заново.
# Админка маппинга: http://localhost:${IDENTITY_ADMIN_PORT}/ (basic-auth).
# ─────────────────────────────────────────────────────────────
TABLEAU_IDENTITY_ENC_KEY=change-me-run-make-identity-key
# Хранилище привязок user→PAT: пусто = зашифрованный YAML-файл; задан URL =
# Postgres (секрет так же зашифрован Fernet, БД/схема создаются сами, YAML
# переливается разово). Пароль = POSTGRES_PASSWORD, хост `postgres` — сервис стека.
IDENTITY_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/tableau_identity
IDENTITY_ADMIN_USER=admin
IDENTITY_ADMIN_PASSWORD=changeme
IDENTITY_ADMIN_PORT=8021
# claim личности в gateway-JWT (обычно sub = email). Меняется только под нестандартный IdP.
IDENTITY_CLAIM=sub
# Проактивное обновление session-token до 240-мин idle-таймаута Tableau (сек).
TABLEAU_SESSION_TTL_SECONDS=13800
# Нагрузка/отказоустойчивость брокера (дефолты разумные, крутить под RPS):
#   UPSTREAM_MAX_CONNECTIONS / UPSTREAM_MAX_KEEPALIVE — пул соединений к tableau-mcp;
#   IDENTITY_DB_TTL_SECONDS — кэш чтения маппинга из БД (сек), брокер не бьёт БД чаще.
UPSTREAM_MAX_CONNECTIONS=200
UPSTREAM_MAX_KEEPALIVE=50
IDENTITY_DB_TTL_SECONDS=3

# Public URL (nginx front). Update for prod behind your own ingress.
APP_DOMAIN=http://localhost:8080
NGINX_PORT=8080

# Keycloak is disabled by default. Do not add --profile sso.
SSO_ENABLED=false
SSO_KEYCLOAK_ENABLED=false

# Use the released ContextForge image; we don't build it locally (Containerfile.lite
# pulls a linux/s390x wheels stage from GHCR that needs auth).
IMAGE_LOCAL=ghcr.io/ibm/mcp-context-forge:v1.0.4

# ─────────────────────────────────────────────────────────────
# Аудит (структурированный лог "кто/что/когда" в Postgres гейта)
#
# STRUCTURED_LOGGING_DATABASE_ENABLED=true  — сохранять structured-логи в БД,
#   включает REST-ручки /api/logs/search, /api/logs/trace/{correlation_id},
#   /api/logs/performance-metrics. Каждый лог содержит user_id, client_ip,
#   user_agent, request_path/method, duration_ms, correlation_id — по нему
#   можно восстановить полный путь запроса от Claude до федерированного MCP.
# AUDIT_TRAIL_ENABLED=true                  — писать audit_trails по каждому
#   вызову API + admin-действию (create/delete tool, register server и т.п.).
#   Открывает /api/logs/audit-trails. Обязательно для SOC2/HIPAA.
# SECURITY_LOGGING_ENABLED=true             — плюс события auth/rate-limit,
#   доступно на /api/logs/security-events.
#
# ВНИМАНИЕ: каждый флаг = DB-write на КАЖДЫЙ запрос. Оставить false для
# бенчмарков и dev, включать для прода/compliance. По умолчанию всё выключено.
# ─────────────────────────────────────────────────────────────
STRUCTURED_LOGGING_DATABASE_ENABLED=false
AUDIT_TRAIL_ENABLED=false
SECURITY_LOGGING_ENABLED=false
# Retention журналов гейта в днях (по умолчанию 30). Согласуйте с политикой (ТС 5.7).
LOG_RETENTION_DAYS=30
#
# Отдельно: брокер tableau-identity ВСЕГДА пишет per-call аудит «учётка ↔ инструмент»
# (JSON-строка в stdout логгера tableau_identity.audit) — точнее гейтового /mcp,
# т.к. видит и личность, и имя инструмента. Формат хранения (лог/БД) — на выбор.

# ─────────────────────────────────────────────────────────────
# Tableau (used by Tableau MCP + dashboard-context)
# ─────────────────────────────────────────────────────────────
TABLEAU_SERVER=https://your-tableau-server.example.com
TABLEAU_SITE_NAME=
TABLEAU_PAT_NAME=change-me
TABLEAU_PAT_VALUE=change-me
# ВАЖНО для Tableau Server: версия API пинится к релизу сервера (Cloud — всегда
# последняя). Выставь под свою версию, иначе /auth/signin может отдать 404.
# Напр.: Server 2022.3→3.17, 2023.1→3.19, 2023.3→3.21, 2024.2→3.24.
TABLEAU_API_VERSION=3.22
# on-prem Server с внутренним/self-signed сертификатом:
#   true (дефолт) — строгая проверка TLS; false — не проверять (только доверенная
#   сеть); путь к CA-bundle внутри контейнера — корректный вариант для on-prem
#   (файл нужно примонтировать в tableau-identity).
TABLEAU_SSL_VERIFY=true
# «MCP site settings» — фича Tableau CLOUD. На Tableau Server запрос падает и
# роняет регистрацию ВСЕХ инструментов tableau-mcp. Для Server оставь false
# (дефолт). На Cloud, если нужны site-настройки набора тулов, поставь true.
TABLEAU_MCP_SITE_SETTINGS=false

# Опциональные ручки Tableau MCP (пусто = дефолты).
TABLEAU_MCP_REF=v2.22.0
TABLEAU_LOG_LEVEL=info
TABLEAU_INCLUDE_TOOLS=
TABLEAU_EXCLUDE_TOOLS=
TABLEAU_MAX_RESULT_LIMIT=
TABLEAU_DATASOURCE_CREDENTIALS=

# ВНИМАНИЕ: в docker-compose захардкожено DISABLE_SESSION_MANAGEMENT=true.
# ContextForge как MCP-клиент не трекает Mcp-Session-Id между запросами,
# поэтому tableau-mcp работает в stateless-режиме — каждый POST self-contained.
# Не трогать без веских причин, иначе tool-вызовы упадут с "Failed to create upstream MCP session".
